# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/smart_attendance

# Server
PORT=4010

# JWT
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=7d

# OTP
OTP_HASH_SECRET=replace-with-otp-hash-secret
LOGIN_OTP_TTL_MS=300000
PASSWORD_RESET_OTP_TTL_MS=600000

# SMTP (required for sending OTP by email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ewoube.anna@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Smart Attendance <ewoube.anna@example.com>"
